views:
  - type: table
    name: Таблица
    filters:
      and:
        - file.folder == "Эскуперей/2. История/z. Известные лица/Учёные"
        - Эпоха == "Эпоха Пороха"
    order:
      - file.name
      - годы
      - Деятельность
      - Специализация
      - Страна
      - Эпоха
    columnSize:
      file.name: 143
      note.годы: 100
      note.Деятельность: 671
      note.Страна: 181
